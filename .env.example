# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. All are optional locally.

# Canonical site URL (used for metadata, sitemap and Stripe return URLs in production)
NEXT_PUBLIC_SITE_URL=https://www.flexifib.com

# Stripe — https://dashboard.stripe.com/apikeys (server-side only; never expose)
STRIPE_SECRET_KEY=sk_test_...

# Resend — form submissions and journey-update sign-ups
RESEND_API_KEY=re_...
# Must be an address on a domain verified in Resend
RESEND_FROM="FlexiFib Website <website@flexifib.com>"
# Optional: Resend segment that newsletter sign-ups are added to
RESEND_NEWSLETTER_SEGMENT_ID=

# Google Analytics 4 — only loaded after a visitor accepts analytics cookies
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Supabase Auth — required for customer accounts, basket access and checkout.
# Enable Google and Apple (and disable Email) in Supabase Auth provider settings.
# Google/Apple client secrets stay in Supabase, never in NEXT_PUBLIC_ variables.
# Use the project URL and PUBLISHABLE key, never a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
